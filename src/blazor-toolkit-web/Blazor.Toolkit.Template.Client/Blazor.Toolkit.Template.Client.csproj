<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
		<StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
		<RootNamespace Condition="'$(name)' != '$(name{-VALUE-FORMS-}safe_namespace)'">Blazor.Toolkit.Template.Client</RootNamespace>
		<AssemblyName Condition="'$(name)' != '$(name{-VALUE-FORMS-}safe_namespace)'">Blazor.Toolkit.Template.Client</AssemblyName>
		<BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.5" />
		<!-- <ProjectReference Include="..\..\src\Syncfusion.Blazor.Toolkit.csproj" /> -->
	</ItemGroup>
</Project>
