@*#if (UseWebAssembly && !InteractivityAtRoot)
<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="new[] { typeof(Client._Imports).Assembly }" NotFoundPage="typeof(Blazor.Toolkit.Template.Components.Pages.NotFound)">
##else
<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Blazor.Toolkit.Template.Components.Pages.NotFound)">
##endif*@
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Blazor.Toolkit.Template.Components.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>